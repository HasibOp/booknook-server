# Copy this file to .env and fill in the real values.

# Local port (ignored on Vercel)
PORT=5000

# MongoDB Atlas connection string (same database the client's BetterAuth uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=BookNook

# Database name
DB_NAME=booknook

# URL of the Next.js client (no trailing slash).
# Used for CORS and to verify BetterAuth JWTs via CLIENT_URL/api/auth/jwks.
CLIENT_URL=http://localhost:3000
